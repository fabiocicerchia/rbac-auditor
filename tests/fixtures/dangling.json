{
  "apiVersion": "rbac-audit/v1",
  "clusterRoleBindings": [
    {
      "name": "ci-admin",
      "roleRef": {
        "kind": "ClusterRole",
        "name": "cluster-admin"
      },
      "subjects": [
        {
          "kind": "ServiceAccount",
          "name": "deployer",
          "namespace": "ci"
        }
      ]
    },
    {
      "name": "view-everyone",
      "roleRef": {
        "kind": "ClusterRole",
        "name": "view"
      },
      "subjects": [
        {
          "kind": "Group",
          "name": "system:authenticated"
        },
        {
          "kind": "Group",
          "name": "system:unauthenticated"
        }
      ]
    }
  ],
  "clusterRoles": [
    {
      "name": "cluster-admin",
      "rules": [
        {
          "apiGroups": [
            "*"
          ],
          "resources": [
            "*"
          ],
          "verbs": [
            "*"
          ]
        }
      ]
    },
    {
      "name": "view",
      "rules": [
        {
          "apiGroups": [
            ""
          ],
          "resources": [
            "pods"
          ],
          "verbs": [
            "get",
            "list",
            "watch"
          ]
        }
      ]
    }
  ],
  "kind": "RbacSnapshot",
  "roleBindings": [
    {
      "name": "grafana-reader",
      "namespace": "apps",
      "roleRef": {
        "kind": "ClusterRole",
        "name": "view"
      },
      "subjects": [
        {
          "kind": "ServiceAccount",
          "name": "grafana",
          "namespace": "apps"
        }
      ]
    },
    {
      "name": "deployer",
      "namespace": "ci",
      "roleRef": {
        "kind": "Role",
        "name": "deploy"
      },
      "subjects": [
        {
          "kind": "ServiceAccount",
          "name": "deployer",
          "namespace": "ci"
        }
      ]
    }
  ],
  "roles": [
    {
      "name": "deploy",
      "namespace": "ci",
      "rules": [
        {
          "apiGroups": [
            "apps"
          ],
          "resources": [
            "deployments"
          ],
          "verbs": [
            "get",
            "list",
            "patch"
          ]
        },
        {
          "apiGroups": [
            "rbac.authorization.k8s.io"
          ],
          "resources": [
            "roles"
          ],
          "verbs": [
            "bind",
            "escalate"
          ]
        },
        {
          "apiGroups": [
            "*"
          ],
          "resources": [
            "secrets"
          ],
          "verbs": [
            "get"
          ]
        }
      ]
    }
  ],
  "serviceAccounts": [
    {
      "name": "deployer",
      "namespace": "ci"
    }
  ]
}
